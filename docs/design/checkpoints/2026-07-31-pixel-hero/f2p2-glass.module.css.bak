/* =============================================================================
   Fan to Pro 2기 — 절제된 글래스 (과하지 않게, 딱 1곳)
   노아 방향: 다크 에디토리얼(기존 1기 언어) + 원티드 철학 + 글래스는 시그니처 1곳.
   글래스 남발 반려 이후 재작성 — glassPanel(최종 CTA) + glassCta(주 버튼)만 남김.
   나머지 카드/섹션은 기존 보더 카드 언어를 그대로 씀 (glass X).
   ============================================================================= */

/* 최종 신청 패널 — 페이지에서 유일하게 글래스가 허용되는 시그니처 표면.
   어두운 tint + inner highlight + border + 그림자. 배경 위에서 은은하게. */
.glassPanel {
  position: relative;
  background:
    linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-brand-pink) 12%, transparent),
      color-mix(in srgb, var(--color-brand-indigo) 8%, transparent)
    ),
    color-mix(in srgb, var(--color-surface) 72%, transparent);
  backdrop-filter: blur(20px) saturate(1.2);
  -webkit-backdrop-filter: blur(20px) saturate(1.2);
  border: 1px solid color-mix(in srgb, var(--color-brand-pink) 22%, var(--color-border));
  border-radius: 4px;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.08),
    0 24px 60px -24px rgba(0, 0, 0, 0.7);
}

/* ===== 터미널/픽셀 크롬 유틸 (컨셉 B) ===== */
/* 모노스페이스 크롬 폰트 */
.mono {
  font-family: var(--font-pixel-mono), ui-monospace, "SF Mono", Menlo, monospace;
}
/* 도트그리드 캔버스 배경 (디자인 툴 아트보드 느낌) */
.canvas {
  background-image: radial-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px);
  background-size: 24px 24px;
  background-position: -1px -1px;
}
/* 터미널 태그 [BADGE] — 샤프, 모노, 대문자 */
.termTag {
  font-family: var(--font-pixel-mono), ui-monospace, Menlo, monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border: 1px solid currentColor;
  border-radius: 2px;
  padding: 2px 7px;
  display: inline-flex;
  align-items: center;
}
/* 깜빡이는 커서 _ */
.blink {
  animation: blink 1.1s step-end infinite;
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .blink { animation: none; }
}

/* =============================================================================
   극도의 픽셀/터미널 컨셉 (컨셉 B, full send)
   ============================================================================= */
/* 한글 지원 픽셀 폰트 */
@font-face {
  font-family: "Galmuri11";
  src: url("https://cdn.jsdelivr.net/npm/galmuri/dist/Galmuri11.woff2") format("woff2");
  font-weight: 400 700;
  font-display: swap;
}
.pixelFont {
  font-family: "Galmuri11", "Space Mono", monospace;
  letter-spacing: 0;
  font-weight: 700;
  image-rendering: pixelated;
}
/* CRT 스캔라인 오버레이 (부모에 position 필요) */
.scanlines::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 6;
  background: repeating-linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.28) 0,
    rgba(0, 0, 0, 0.28) 1px,
    transparent 1px,
    transparent 3px
  );
}
/* 네온 글로우 (CRT 발광) */
.neon {
  text-shadow:
    0 0 10px color-mix(in srgb, var(--color-brand-pink) 65%, transparent),
    0 0 2px color-mix(in srgb, var(--color-brand-pink) 90%, transparent);
}
/* 터미널 윈도우 타이틀바 */
.windowBar {
  display: flex;
  align-items: center;
  gap: 8px;
  border-bottom: 2px solid var(--color-border-strong);
  padding: 9px 14px;
  background: rgba(0, 0, 0, 0.55);
  font-family: "Galmuri11", "Space Mono", monospace;
  font-size: 12px;
  color: var(--color-fg-muted);
}
.winDot {
  width: 11px;
  height: 11px;
  display: inline-block;
}
/* 청키 픽셀 버튼 — 하드 오프셋 그림자, radius 0, 누르면 밀림 */
.pixelBtn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-family: "Galmuri11", "Space Mono", monospace;
  background: var(--color-brand-pink);
  color: #fff;
  border: 2px solid #fff;
  border-radius: 0;
  box-shadow: 5px 5px 0 0 rgba(0, 0, 0, 0.9);
  transition:
    transform 0.08s steps(2),
    box-shadow 0.08s steps(2);
}
.pixelBtn:hover {
  transform: translate(-1px, -1px);
  box-shadow: 7px 7px 0 0 rgba(0, 0, 0, 0.9);
}
.pixelBtn:active {
  transform: translate(5px, 5px);
  box-shadow: 0 0 0 0 rgba(0, 0, 0, 0.9);
}
.pixelBtnGhost {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-family: "Galmuri11", "Space Mono", monospace;
  background: transparent;
  color: var(--color-fg);
  border: 2px solid var(--color-border-strong);
  border-radius: 0;
  box-shadow: 5px 5px 0 0 rgba(0, 0, 0, 0.55);
  transition:
    transform 0.08s steps(2),
    box-shadow 0.08s steps(2),
    border-color 0.12s;
}
.pixelBtnGhost:hover {
  border-color: var(--color-brand-pink);
  transform: translate(-1px, -1px);
  box-shadow: 7px 7px 0 0 rgba(0, 0, 0, 0.55);
}
.pixelBtnGhost:active {
  transform: translate(5px, 5px);
  box-shadow: 0 0 0 0 rgba(0, 0, 0, 0.55);
}
/* 청키 픽셀 보더 */
.pixelBorder {
  border: 2px solid var(--color-border-strong);
  border-radius: 0;
}

/* 주 CTA 버튼 — solid 핑크 + 미세한 유리 하이라이트. 눌러야 할 게 분명하게. */
.glassCta {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: var(--color-brand-pink);
  border: 1px solid color-mix(in srgb, var(--color-brand-pink) 55%, #fff 25%);
  border-radius: 3px;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.25),
    0 8px 24px -8px color-mix(in srgb, var(--color-brand-pink) 60%, transparent);
  transition:
    transform 0.15s ease,
    box-shadow 0.2s ease,
    background-color 0.15s ease;
}
.glassCta:hover {
  background: color-mix(in srgb, var(--color-brand-pink) 88%, #fff);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.3),
    0 12px 32px -8px color-mix(in srgb, var(--color-brand-pink) 70%, transparent);
}
.glassCta:active {
  transform: scale(0.98);
}

/* 보조 ghost 버튼 — 테두리만, 채우지 않음. */
.ghostCta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border: 1px solid var(--color-border-strong);
  border-radius: 3px;
  transition:
    border-color 0.15s ease,
    background-color 0.15s ease;
}
.ghostCta:hover {
  border-color: var(--color-fg-muted);
  background: color-mix(in srgb, var(--color-fg) 5%, transparent);
}

/* 섹션 등장 — 위→아래 순차 fade (motion-safe). */
@media (prefers-reduced-motion: no-preference) {
  .reveal {
    opacity: 0;
    transform: translateY(12px);
    animation: revealUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
}

/* 자동 무한 스와이프 (GC 히어로 배경) — 이미지 스트립이 좌로 끝없이 흐름.
   트랙에 이미지 세트를 2벌 넣고 -50% 이동 = 이음매 없는 루프. 순수 CSS(JS X). */
.marqueeTrack {
  display: flex;
  height: 100%;
  width: max-content;
  animation: marquee 48s linear infinite;
}
.marqueeItem {
  position: relative;
  height: 100%;
  width: 40vw;
  min-width: 380px;
  flex: 0 0 auto;
}
@keyframes marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}
@media (prefers-reduced-motion: reduce) {
  .marqueeTrack {
    animation: none;
  }
}

/* =============================================================================
   Figma 협업 커서 (히어로) — 닉네임 단 커서가 함께 작업하듯 떠다님.
   순수 CSS(JS X). 각 커서는 base 위치 + float 키프레임으로 유기적 이동.
   ============================================================================= */
.cursorLayer {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}
.cursor {
  position: absolute;
  display: flex;
  align-items: flex-start;
  will-change: transform;
}
.cursorLabel {
  margin-top: 16px;
  margin-left: 10px;
  font-family: var(--font-pixel-mono), ui-monospace, "SF Mono", Menlo, monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: #fff;
  padding: 2px 8px;
  border-radius: 2px;
  white-space: nowrap;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
}
.float1 { animation: float1 8s ease-in-out infinite; }
.float2 { animation: float2 9.5s ease-in-out infinite; }
.float3 { animation: float3 7s ease-in-out infinite; }
.float4 { animation: float4 10s ease-in-out infinite; }
.float5 { animation: float5 8.5s ease-in-out infinite; }
@keyframes float1 {
  0%, 100% { transform: translate(0, 0); }
  25% { transform: translate(34px, -26px); }
  50% { transform: translate(-18px, -44px); }
  75% { transform: translate(-38px, 16px); }
}
@keyframes float2 {
  0%, 100% { transform: translate(0, 0); }
  30% { transform: translate(-30px, 22px); }
  60% { transform: translate(24px, 40px); }
  80% { transform: translate(40px, -14px); }
}
@keyframes float3 {
  0%, 100% { transform: translate(0, 0); }
  20% { transform: translate(-40px, -18px); }
  55% { transform: translate(-14px, 34px); }
  85% { transform: translate(28px, 20px); }
}
@keyframes float4 {
  0%, 100% { transform: translate(0, 0); }
  35% { transform: translate(26px, 30px); }
  65% { transform: translate(-32px, 12px); }
  90% { transform: translate(-10px, -30px); }
}
@keyframes float5 {
  0%, 100% { transform: translate(0, 0); }
  25% { transform: translate(-24px, -30px); }
  50% { transform: translate(30px, -20px); }
  75% { transform: translate(18px, 32px); }
}
@media (prefers-reduced-motion: reduce) {
  .cursor {
    animation: none !important;
  }
}
