                    {r.country.slice(0, 1)}
                  </span>
                  <span className="text-fg-muted text-sm">{r.country} 수강생</span>
                </figcaption>
              </figure>
            ))}
          </div>
          <p className="mt-5 text-fg-subtle text-xs">
            실제 후기는 1기 수강생 동의 아래 순차 공개됩니다.
          </p>
        </div>
      </section>

      {/* ===== 신청 (SIGNATURE 글래스 — 유일) ===== */}
      <section id="apply" className={`${WRAP} scroll-mt-20 py-24`}>
        <div className={`${styles.glassPanel} relative overflow-hidden p-10 sm:p-16`}>
          <div aria-hidden className="pointer-events-none absolute inset-0 -z-10 opacity-25">
            <Image src="/images/stock/korean-concert-audience-1.jpg" alt="" fill sizes="100vw" className="object-cover" />
            <div className="absolute inset-0 bg-gradient-to-r from-bg via-bg/70 to-bg/30" />
          </div>
          <h2 className="max-w-2xl font-black text-display-sm" style={LEAD_SM}>
            무대는 이미
            <br />
            당신을 기다립니다.
          </h2>
          <p className="mt-5 max-w-lg text-fg-muted text-lg leading-relaxed">
            Fan to Pro 2기, 모집 일정이 확정되면 가장 먼저 안내드립니다.
          </p>
          <div className="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href="#" className={`${styles.glassCta} px-9 py-4 font-bold text-base text-white`}>
              2기 신청하기
            </a>
            <span className="text-fg-subtle text-sm">
              수강료 결제 후 이메일로 계정을 안내드립니다.
            </span>
          </div>
        </div>
      </section>

      {/* ===== Footer ===== */}
      <footer className="border-border border-t">
        <div className={`${WRAP} flex flex-col gap-2 py-12 text-fg-subtle text-xs leading-relaxed`}>
          <p className="font-bold text-fg-muted">Growth Career | Fan to Pro</p>
          <p>수료증 발급 Dropdown (사업자 154-28-02110). 공연 프로젝트 참여 확인서 유니온 픽처스.</p>
          <p>강사 섭외 및 운영 협력 DEEPI. 문의는 카카오톡 채널 또는 신청 후 안내 메일.</p>
          <p className="mt-3 text-fg-subtle">프리뷰 v4. 내부 검토용 draft.</p>
        </div>
      </footer>
    </main>
  );
}
