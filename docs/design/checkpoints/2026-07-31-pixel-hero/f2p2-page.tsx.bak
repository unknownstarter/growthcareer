import type { Metadata } from "next";
import Image from "next/image";
import { Space_Mono } from "next/font/google";
import styles from "./glass.module.css";

// 터미널/픽셀 크롬 폰트 (라벨·넘버·태그·핸들). 한국어 본문/헤드라인은 Pretendard 유지.
const pixelMono = Space_Mono({
  weight: ["400", "700"],
  subsets: ["latin"],
  variable: "--font-pixel-mono",
  display: "swap",
});

/* =============================================================================
   TEMP 프리뷰 v4 — Fan to Pro (K-ent) 2기 모집 페이지
   방향(노아): 다크 에디토리얼 + 원티드 철학 + 절제된 글래스(시그니처 = 최종 CTA).
   v4 반영:
   - 컨테이너 max 1120px 센터 + gutter 20/32px, 배경 full-bleed / 콘텐츠 컨테이너 (Aria 토큰)
   - 한국어 타이틀 line-height 상향 (display-lg 1.15, display-sm 1.25 — Aria 토큰)
   - 히어로 강화 + 콘서트 사진 삽입(임팩트), 섹션별 이미지
   - 아이돌 정식 명칭 X, 2기 미정값 "확정 예정", 8개국 사실 기반
   전역 globals.css 는 안 건드림 (라이브 1기 회귀 방지 §7.4). 토큰은 이 페이지 로컬.
   noindex. 실 라우트 이관은 #14 결정 후.
   ============================================================================= */

export const metadata: Metadata = {
  title: "Fan to Pro 2기 (프리뷰)",
  robots: { index: false, follow: false },
};

// 로컬 컨테이너 (Aria: max 1120px, gutter 20/32px). 배경은 full-bleed, 콘텐츠만 가둠.
const WRAP = "mx-auto w-full max-w-[1120px] px-5 md:px-8";
// 한국어 타이틀 줄간격 (Aria 토큰) — 라틴 1.05 대신 상향.
const LEAD_LG = { lineHeight: 1.16, letterSpacing: "-0.035em" } as const;
const LEAD_SM = { lineHeight: 1.24, letterSpacing: "-0.03em" } as const;

const NINO = {
  name: "Nino",
  nameSub: "이세환",
  role: "A&R 디렉터",
  affiliation: ["Sherpa Music CEO", "27년차 뮤직 비즈니스"],
  photo: "/images/instructors/nino-lee.jpg",
  // 아이돌/음반/프로그램 정식 명칭은 노출 금지 (권리 이슈). 역할과 규모만.
  credits: [
    {
      label: "CJ ENM A&R",
      items: [
        "국내 최대 규모 아이돌 오디션 프로그램 시리즈",
        "글로벌 데뷔 아이돌 그룹 다수 음반 기획",
        "한국과 일본 아이돌 프로젝트 A&R 총괄",
      ],
    },
    {
      label: "Sherpa Music CEO",
      items: [
        "음원 기획 및 아티스트 비주얼 디렉팅",
        "음악 시상식 수상 아티스트 프로젝트",
        "국내외 290여 팀 작가 계약 총괄",
      ],
    },
  ],
};

const OPTIONS = [
  {
    tag: "단과",
    title: "A&R 단과반",
    lead: "Nino 확정",
    desc: "아이돌을 만드는 A&R의 실제 업무. 기획, 캐스팅, 음반 제작 전략을 현업 디렉터에게 직접 배웁니다.",
    included: false,
  },
  {
    tag: "올인원",
    title: "전 과정 패키지",
    lead: "A&R 단과 포함",
    desc: "A&R 단과반을 포함한 K엔터 실무 풀 트랙. 실제 공연 프로젝트 참여로 포트폴리오까지 완성합니다.",
    included: true,
  },
];

// 1기 실제 국적 (Supabase, 10명 8개국). 후기 본문은 실제 후기로 교체 예정.
const REVIEW_SLOTS = [{ country: "베트남" }, { country: "프랑스" }, { country: "중국" }];

// 히어로 협업 커서 — 1기 8개국 학생 + Nino. 함께 만들어가는 느낌 + 온브랜드.
const CURSORS = [
  { name: "LINH_V", color: "#ec4899", anim: "float1", top: "22%", left: "56%" },
  { name: "MEI_C", color: "#6366f1", anim: "float2", top: "64%", left: "68%" },
  { name: "PIERRE_F", color: "#8b5cf6", anim: "float3", top: "36%", left: "82%" },
  { name: "SOFIA_M", color: "#d946ef", anim: "float4", top: "76%", left: "52%" },
  { name: "NINO", color: "#a855f7", anim: "float5", top: "14%", left: "74%" },
] as const;

export default function F2P2PreviewPage() {
  return (
    <main className={`${pixelMono.variable} ${styles.canvas} min-h-screen bg-bg text-fg`}>
