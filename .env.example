# Kenter Bootcamp · 환경 변수
# 실제 값은 .env.local 에 (gitignored). Vercel 배포 시 Project Settings 에 등록.

# Supabase 프로젝트 URL — 클라이언트/서버 모두 노출 OK
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key — 클라이언트 노출 OK (RLS 가 보호)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase service_role key — 서버 전용. 절대 클라이언트로 흘리지 말 것.
# applicants 테이블 INSERT 시 RLS 우회 목적으로 서버 액션에서만 사용.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
